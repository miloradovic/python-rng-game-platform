APP_ENV=development
APP_NAME=Python-RNG-Game-Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO
POSTGRES_DB=rng_game_platform
POSTGRES_USER=rng_app
POSTGRES_PASSWORD=local-password
DATABASE_URL=postgresql+asyncpg://rng_app:local-password@db:5432/rng_game_platform
# The following test values are read only by the explicit compose.test.yaml overlay.
TEST_POSTGRES_DB=rng_game_platform_test
TEST_DATABASE_URL=postgresql+asyncpg://rng_app:local-password@db_test:5432/rng_game_platform_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1
# Application keys are unprefixed by default. Pytest assigns a unique namespace per run.
REDIS_KEY_NAMESPACE=
LEADERBOARD_PROJECTION_HMAC_SECRET=development-only-projection-key-32-bytes-minimum
# During rotation, keep the former key here until every old generation has expired/rebuilt.
LEADERBOARD_PROJECTION_PREVIOUS_HMAC_SECRET=
OUTCOME_HMAC_SECRET=development-only-outcome-key-32-bytes-minimum
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_SECONDS=1
SETTLEMENT_ADMIN_TOKEN=development-only-settlement-token
