APP_ENV=development
APP_NAME=Python-RNG-Game-Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO
POSTGRES_DB=rng_game_platform
POSTGRES_USER=rng_app
POSTGRES_PASSWORD=local-password
DATABASE_URL=postgresql+asyncpg://rng_app:local-password@db:5432/rng_game_platform
TEST_POSTGRES_DB=rng_game_platform_test
TEST_DATABASE_URL=postgresql+asyncpg://rng_app:local-password@db_test:5432/rng_game_platform_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1
OUTCOME_HMAC_SECRET=development-only-outcome-key-32-bytes-minimum
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=1
SETTLEMENT_ADMIN_TOKEN=development-only-settlement-token
